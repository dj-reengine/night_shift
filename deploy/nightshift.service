[Unit]
Description=Night Shift dashboard
After=network-online.target

[Service]
WorkingDirectory=/opt
Environment=PYTHONPATH=/opt
Environment=NIGHTSHIFT_ROOT=/var/lib/night-shift
Environment=NIGHTSHIFT_ENV=/var/lib/night-shift/secrets/night-shift.env
Environment=NIGHTSHIFT_PORT=8080
ExecStart=/usr/bin/python3 -m nightshift
Restart=on-failure

[Install]
WantedBy=multi-user.target
